<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.4</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- The published contracts, not a sibling checkout: this repo used to fail to build whenever
         the KHost checkout beside it changed branch, and an outside author has no such checkout at
         all. The package's own targets keep them out of this project's output, so nothing
         downstream loses them. Both are MIT, so no PolyForm code reaches what this redistributes. -->
    <PackageReference Include="KHost.Abstractions" Version="0.47.0" />
    <PackageReference Include="KHost.Common" Version="0.47.0" />

    <!-- Came in through KHost.Plugins.Sdk before it was folded into Abstractions, which
         declares contracts and takes no packages of its own. The host has this loaded, so a
         shipped copy is never the one used. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- The stale-yt-dlp signature list is an implementation detail, but it is the part worth
         pinning: it decides whether a host is told to update or handed a stack trace. -->
    <InternalsVisibleTo Include="KHost.Plugins.YouTube.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
